# Somente documentacao: a configuracao do systemd se faz por EnvironmentFile
# ou por drop-ins em /etc/systemd/system/vaga-api.service.d/.
# Sem sensor, fechamento automatico fica DESLIGADO por padrao.
VAGA_FECHAMENTO_TESTE=0
VAGA_AUTO_SEM_SENSOR_BANCADA=0
