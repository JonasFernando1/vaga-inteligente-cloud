# Copie para .env.supabase (no Raspberry: /home/vaga/vaga-inteligente/.env.supabase)
# e preencha. O .env.supabase real NUNCA vai para o Git.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave SECRETA (Project Settings -> API Keys -> secret / service_role).
# Ela ignora as regras de seguranca do banco: so no Raspberry.
SUPABASE_SECRET_KEY=COLE_A_CHAVE_SECRETA_AQUI
# API local do Raspberry (no PC, o simulador usa o mesmo endereco)
VAGA_API=http://127.0.0.1:8000
