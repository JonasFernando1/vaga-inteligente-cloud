[Unit]
Description=Vaga Inteligente - Dashboard Local
After=network.target vaga-api.service
Wants=vaga-api.service

[Service]
Type=simple
User=vaga
WorkingDirectory=/home/vaga/vaga-inteligente
ExecStart=/home/vaga/vaga-inteligente/venv/bin/python -m streamlit run dashboard_local.py --server.headless=true --server.address=0.0.0.0 --server.port=8501 --server.fileWatcherType=none
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
